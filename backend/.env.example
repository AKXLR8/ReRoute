# ReRouteAI — Development defaults
# Copy to .env and fill in real values for production

# Database (matches docker-compose postgres)
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/reroute

# Redis (matches docker-compose redis)
REDIS_URL=redis://localhost:6379/0

# Auth — CHANGE THESE in production
JWT_SECRET=change-me-in-production-please
ADMIN_API_KEY=change-me-admin-key

# Accounts — self-service sign-up (first account becomes admin)
ALLOW_REGISTRATION=true
REGISTER_RATE_LIMIT_PER_HOUR=5

# GitHub OAuth (https://github.com/settings/developers -> OAuth Apps -> New)
# Callback URL must equal GITHUB_REDIRECT_URI
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# where the callback hands the session back to the SPA
# FRONTEND_BASE_URL=http://localhost:5173

# Provider API keys — set the ones you want to use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MERCURY_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# CORS (comma-separated origins, or * for local dev)
# CORS_ORIGINS=http://localhost:5173

# Hosts allowed to serve the API (comma-separated; * for local dev)
# ALLOWED_HOSTS=api.example.com

# BYOK encryption key (32+ random chars). Encrypts users' stored provider
# keys. Empty = derives from JWT_SECRET. SET THIS before users connect keys —
# rotating it later makes every stored key unreadable.
# FERNET_KEY=

# Tracing (OpenTelemetry → OTLP/HTTP). Empty = tracing disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=rerouteai

# --- Deployment ---
# ENVIRONMENT=production    # refuses wildcard CORS/hosts + placeholder secrets
# MIGRATE_ON_STARTUP=true   # false when migrations run as a separate release step
# UVICORN_WORKERS=4
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info
# Proxy: behind nginx/ALB, set FORWARDED_ALLOW_IPS to the proxy's IP so the
# login throttle sees real client IPs (X-Forwarded-For). Only when the proxy
# strips client-supplied X-Forwarded-For — otherwise IPs are spoofable.
# UVICORN_PROXY_HEADERS=true
# FORWARDED_ALLOW_IPS=127.0.0.1
